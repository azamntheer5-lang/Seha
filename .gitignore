# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env can hold real secrets (e.g. SUPABASE_SERVICE_KEY), so it
# is local-only; the committed template is .env.example. Override locally
# with .env.local if needed.
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log

# prisma generated client
node_modules/.prisma
node_modules/@prisma/client

# sandbox working artifacts — never deploy these (they bloat the traced
# serverless bundle and have nothing to do with the app)
/upload/
/skills/
/download/
/.netlify/
/netlify.toml.bak
