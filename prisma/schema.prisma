// Prisma schema — Seha Sick Leave Inquiry platform
// SQLite datasource, production-ready modeling with indexes for fast lookups.

generator client {
  provider = "prisma-client-js"
  // "native"  → build machine (local dev + Netlify Ubuntu build image).
  // "rhel-openssl-3.0.x" → AWS Lambda runtime that powers Netlify Functions.
  // Without the rhel target the query engine .so is missing at runtime on
  // Netlify and every API call fails with "query engine not found".
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Sick leave certificates issued by health facilities.
// (serviceCode, patientId) is the PUBLIC lookup pair — the inquiry page asks
// for both, so the service code alone does not need global uniqueness. This
// lets an operator re-issue the exact same code for the same patient (update
// in place) and freely pick codes without clashing with other patients'
// certificates.
model SickLeave {
  id               String   @id @default(cuid())
  serviceCode      String // رمز الخدمة (PSL261…, GSL261… or SL-2025-…)
  patientId        String // رقم الهوية / الإقامة (10 digits)
  patientName      String // الاسم (عربي)
  patientNameEn    String? // الاسم (إنجليزي)
  patientPhone     String? // جوال العميل (للتواصل)
  companionName    String? // اسم المرافق
  relationship     Int? // صلة القرابة (code, see RELATIONSHIP_LABELS)
  sickLeaveDate    DateTime // تاريخ إصدار تقرير الإجازة
  dateFrom         DateTime // تبدأ من
  dateTo           DateTime // وحتى
  dateFromHijri    String? // التاريخ الهجري للدخول (DD-MM-YYYY)
  dateToHijri      String? // التاريخ الهجري للخروج (DD-MM-YYYY)
  durationDays     Int // المدة بالأيام
  doctorName       String // اسم الطبيب (عربي)
  doctorNameEn     String? // اسم الطبيب (إنجليزي)
  doctorJobTitle   String // المسمى الوظيفي (عربي)
  doctorJobTitleEn String? // المسمى الوظيفي (إنجليزي)
  hospital         String // المنشأة الصحية (عربي)
  hospitalEn       String? // المنشأة الصحية (إنجليزي)
  licenseNumber    String? // رقم ترخيص المنشأة
  employerAr       String? // جهة العمل
  nationalityAr    String? // الجنسية (عربي)
  nationalityEn    String? // الجنسية (إنجليزي)
  status           String   @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED
  verificationCode String // رمز التحقق (QR)
  templateId       String   @default("official") // قالب التقرير (src/lib/seha/templates.ts)
  addQr            Boolean  @default(false) // إظهار QR في التقرير
  showLicense      Boolean  @default(true) // إظهار رقم الترخيص
  reportTime       String? // طابع الوقت المطبوع (05:22 PM)
  reportDate       String? // التاريخ المطبوع (Thursday, 29 October 2026)
  source           String   @default("seed") // seed | portal
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([serviceCode, patientId])
  @@index([patientId, serviceCode])
  @@index([status])
  @@index([createdAt])
}

// Audit log for inquiry requests (privacy-preserving: patient IDs are masked).
model InquiryLog {
  id          String   @id @default(cuid())
  serviceCode String
  patientId   String // masked (e.g. 10******89)
  ipHash      String? // sha256 of client IP, never the raw IP
  success     Boolean
  resultCount Int      @default(0)
  errorCode   String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
