# Portable SQLite path (resolved relative to prisma/schema.prisma).
# Works on any machine after clone — no absolute paths, no secrets.
DATABASE_URL=file:../db/custom.db

# ── Supabase (ACTIVE durable cloud storage) ───────────────────────────────
# When both are set, all sick-leave saves/lookups go to the shared cloud
# database (tables created once with supabase/schema.sql — see README).
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<sb_secret_… key — raw or base64-encoded; the app
#                      decodes base64 automatically (that is the transport
#                      form used in netlify.toml to satisfy GitHub push
#                      protection on public repositories)>
# SUPABASE_PUBLISHABLE_KEY=<sbp_… key — safe for the client, RLS-scoped>
# (The publishable key is optional: it is only needed if you later add
#  client-side Supabase features such as auth or realtime subscriptions.)
